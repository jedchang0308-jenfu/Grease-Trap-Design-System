{
  "name": "grease-trap-calculation-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3100",
    "dev:server": "next dev -H 0.0.0.0 -p 3100",
    "dev:local": "tsx scripts/dev-local.ts",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3100",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\" \"tests/**/*.{ts,tsx}\" \"*.{ts,mjs,json}\" .prettierrc.json",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\" \"tests/**/*.{ts,tsx}\" \"*.{ts,mjs,json}\" .prettierrc.json",
    "typecheck": "next typegen && tsc --noEmit",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:wait": "tsx scripts/db/wait.ts",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:seed": "tsx scripts/db/seed.ts",
    "db:verify": "tsx scripts/db/verify.ts",
    "db:prepare": "npm run db:up && npm run db:wait && npm run db:migrate && npm run db:seed && npm run db:verify",
    "test": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:integration": "npm run db:prepare && vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm run typecheck && npm run test && npm run test:integration && npm run build && npm run test:e2e",
    "report:samples": "tsx scripts/reports/generate-samples.ts"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "dotenv": "17.4.2",
    "next": "16.2.10",
    "pg": "8.22.0",
    "playwright": "1.61.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "prettier": "3.8.2",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
