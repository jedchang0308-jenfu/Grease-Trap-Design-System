{
  "name": "grease-trap-calculation-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare:report-fonts": "node scripts/prepare-report-fonts.mjs",
    "predev": "npm run prepare:report-fonts",
    "dev": "vite --host 0.0.0.0 --port 3100",
    "predev:local": "npm run prepare:report-fonts",
    "dev:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-firebase-emulators.ps1",
    "dev:e2e": "node scripts/start-e2e-server.mjs",
    "prebuild": "npm run prepare:report-fonts",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3200",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.{ts,mjs}\" \"tests/**/*.{ts,tsx}\" \"*.{ts,mjs,json,html}\" .prettierrc.json",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.{ts,mjs}\" \"tests/**/*.{ts,tsx}\" \"*.{ts,mjs,json,html}\" .prettierrc.json",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run prepare:report-fonts",
    "test": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:integration": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-firebase-emulators.ps1 -Test",
    "test:firebase": "npm run test:integration",
    "test:e2e": "playwright test",
    "test:all": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:integration && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "decimal.js": "10.6.0",
    "firebase": "12.16.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "^7.18.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@fontsource-variable/noto-sans-tc": "^5.2.10",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-tools": "15.24.0",
    "globals": "^16.5.0",
    "prettier": "3.8.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
