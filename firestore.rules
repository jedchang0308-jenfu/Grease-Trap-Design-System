rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function exactCaseFields(data) {
      return data.keys().hasOnly([
        'schemaVersion',
        'id',
        'caseGroupId',
        'caseNo',
        'revisionNo',
        'customer',
        'location',
        'title',
        'purpose',
        'diningType',
        'taskCode',
        'mode',
        'lifecycleStatus',
        'calculationStatus',
        'version',
        'createdBy',
        'createdByName',
        'preparedBy',
        'preparedByName',
        'createdAt',
        'updatedAt',
        'inputPayloadJson',
        'calculationsJson',
        'assessmentsJson',
        'overridesJson',
        'reportDraftJson'
      ]);
    }

    function nullableString(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function activeLifecycle(status) {
      return status in ['DRAFT', 'INPUT_READY', 'CALCULATED', 'REPORT_DRAFT'];
    }

    function validCase(data, caseId) {
      return exactCaseFields(data)
        && data.schemaVersion == '3.0'
        && data.id is string
        && data.id.matches('^[0-9a-fA-F-]{36}$')
        && data.caseGroupId == caseId
        && data.caseGroupId.matches('^[0-9a-fA-F-]{36}$')
        && data.caseNo is string
        && data.caseNo.size() > 0
        && data.caseNo.size() <= 40
        && data.revisionNo is int
        && data.revisionNo >= 1
        && data.revisionNo <= 10000
        && data.customer is string
        && data.customer.size() <= 160
        && data.location is string
        && data.location.size() <= 240
        && data.title is string
        && data.title.size() <= 160
        && data.purpose is string
        && data.purpose.size() <= 500
        && nullableString(data.diningType, 160)
        && data.taskCode in [
          'T01_DINERS_TO_FLOW',
          'T02_DINERS_TO_DESIGN',
          'T03_AREA_TO_FLOW',
          'T04_AREA_TO_DESIGN',
          'T05_DESIGN_TO_DINERS_AND_AREA',
          'T06_EFFECTIVE_VOLUME_TO_FLOW'
        ]
        && (data.taskCode != 'T06_EFFECTIVE_VOLUME_TO_FLOW' || data.mode == 'LEGACY_QV')
        && data.mode in ['CURRENT_QG', 'LEGACY_QV', 'DUAL_COMPARISON']
        && data.lifecycleStatus in [
          'DRAFT',
          'INPUT_READY',
          'CALCULATED',
          'REPORT_DRAFT',
          'DELETING',
          'IN_REVIEW',
          'REVIEWED',
          'ISSUED',
          'SUPERSEDED'
        ]
        && (
          data.calculationStatus == null
          || data.calculationStatus in [
            'BLOCKED',
            'COMPLETE',
            'COMPLETE_WITH_REMINDER'
          ]
        )
        && data.version is int
        && data.version >= 1
        && data.version <= 1000000
        && data.createdBy is string
        && data.createdBy.size() > 0
        && data.createdBy.size() <= 128
        && data.createdByName is string
        && data.createdByName.size() > 0
        && data.createdByName.size() <= 160
        && nullableString(data.preparedBy, 128)
        && nullableString(data.preparedByName, 160)
        && data.createdAt is string
        && data.createdAt.size() <= 40
        && data.updatedAt is string
        && data.updatedAt.size() <= 40
        && data.inputPayloadJson is string
        && data.inputPayloadJson.size() <= 60000
        && data.calculationsJson is string
        && data.calculationsJson.size() <= 320000
        && data.assessmentsJson is string
        && data.assessmentsJson.size() <= 60000
        && data.overridesJson is string
        && data.overridesJson.size() <= 60000
        && data.reportDraftJson is string
        && data.reportDraftJson.size() <= 360000;
    }

    function sameCaseIdentity(before, after) {
      return after.caseGroupId == before.caseGroupId
        && after.caseNo == before.caseNo
        && after.createdBy == before.createdBy
        && after.createdAt == before.createdAt;
    }

    function sameCaseDocument(before, after) {
      return after.schemaVersion == before.schemaVersion
        && after.id == before.id
        && after.caseGroupId == before.caseGroupId
        && after.caseNo == before.caseNo
        && after.revisionNo == before.revisionNo
        && after.customer == before.customer
        && after.location == before.location
        && after.title == before.title
        && after.purpose == before.purpose
        && after.diningType == before.diningType
        && after.taskCode == before.taskCode
        && after.mode == before.mode
        && after.lifecycleStatus == before.lifecycleStatus
        && after.calculationStatus == before.calculationStatus
        && after.version == before.version
        && after.createdBy == before.createdBy
        && after.createdByName == before.createdByName
        && after.preparedBy == before.preparedBy
        && after.preparedByName == before.preparedByName
        && after.createdAt == before.createdAt
        && after.updatedAt == before.updatedAt
        && after.inputPayloadJson == before.inputPayloadJson
        && after.calculationsJson == before.calculationsJson
        && after.assessmentsJson == before.assessmentsJson
        && after.overridesJson == before.overridesJson
        && after.reportDraftJson == before.reportDraftJson;
    }

    function validRevisionHead(before, after, caseId) {
      return sameCaseIdentity(before, after)
        && after.id != before.id
        && after.revisionNo == before.revisionNo + 1
        && after.version == before.version + 1
        && after.lifecycleStatus == 'DRAFT'
        && existsAfter(/databases/$(database)/documents/cases/$(caseId)/revisions/$(before.id))
        && sameCaseDocument(
          before,
          getAfter(/databases/$(database)/documents/cases/$(caseId)/revisions/$(before.id)).data
        );
    }

    match /cases/{caseId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && validCase(request.resource.data, caseId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.version == 1
        && request.resource.data.revisionNo == 1
        && request.resource.data.lifecycleStatus == 'DRAFT'
        && request.resource.data.calculationStatus == null;

      allow update: if signedIn()
        && validCase(request.resource.data, caseId)
        && (
          (
            activeLifecycle(resource.data.lifecycleStatus)
            && activeLifecycle(request.resource.data.lifecycleStatus)
            && sameCaseIdentity(resource.data, request.resource.data)
            && request.resource.data.id == resource.data.id
            && request.resource.data.revisionNo == resource.data.revisionNo
            && request.resource.data.version == resource.data.version + 1
          )
          || (
            activeLifecycle(resource.data.lifecycleStatus)
            && validRevisionHead(resource.data, request.resource.data, caseId)
          )
          || (
            activeLifecycle(resource.data.lifecycleStatus)
            && request.resource.data.lifecycleStatus == 'DELETING'
            && request.resource.data.id == resource.data.id
            && request.resource.data.revisionNo == resource.data.revisionNo
            && request.resource.data.version == resource.data.version + 1
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'lifecycleStatus',
              'version',
              'updatedAt'
            ])
          )
        );

      allow delete: if signedIn()
        && resource.data.lifecycleStatus == 'DELETING';
    }

    match /cases/{caseId}/revisions/{recordId} {
      allow read: if signedIn()
        && exists(/databases/$(database)/documents/cases/$(caseId));

      allow create: if signedIn()
        && exists(/databases/$(database)/documents/cases/$(caseId))
        && recordId == get(/databases/$(database)/documents/cases/$(caseId)).data.id
        && sameCaseDocument(
          get(/databases/$(database)/documents/cases/$(caseId)).data,
          request.resource.data
        )
        && existsAfter(/databases/$(database)/documents/cases/$(caseId))
        && getAfter(/databases/$(database)/documents/cases/$(caseId)).data.revisionNo
          == get(/databases/$(database)/documents/cases/$(caseId)).data.revisionNo + 1
        && getAfter(/databases/$(database)/documents/cases/$(caseId)).data.id
          != get(/databases/$(database)/documents/cases/$(caseId)).data.id
        && getAfter(/databases/$(database)/documents/cases/$(caseId)).data.version
          == get(/databases/$(database)/documents/cases/$(caseId)).data.version + 1
        && getAfter(/databases/$(database)/documents/cases/$(caseId)).data.lifecycleStatus == 'DRAFT';

      allow update: if false;

      allow delete: if signedIn()
        && get(/databases/$(database)/documents/cases/$(caseId)).data.lifecycleStatus == 'DELETING';
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
