# Default local mode: no external database, emulator, or cloud credentials required.
DATA_BACKEND=local-file
AUTH_BACKEND=local
APP_URL=http://localhost:3100
PORT=3100
LOCAL_SEED_USER_ID=local-engineer
LOCAL_SEED_USER_NAME=本機工程使用者
LOCAL_DATA_FILE=output/local-data/case-store.json
REPORT_OUTPUT_DIR=output/pdf

# Firebase emulator or non-App-Hosting mode.
# App Hosting injects Firebase Web/Admin SDK configuration when the backend is
# associated with a Firebase Web App, so NEXT_PUBLIC_FIREBASE_* is optional there.
# Enable Firebase Anonymous Auth for public-link access.
# DATA_BACKEND=firestore
# AUTH_BACKEND=firebase
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
# NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
# NEXT_PUBLIC_FIREBASE_APP_ID=your-web-app-id
