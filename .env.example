# Public Firebase Web App configuration. These values identify the Firebase
# project; they are not secrets. Firestore Rules enforce data access.
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-web-app-id

# Local development only. Never enable this in a production Hosting build.
# VITE_USE_FIREBASE_EMULATORS=true
